# Copy to .env and fill in real values. Never commit the real .env file.

# Trend Vision One API key (create one under Administration > API Keys).
# Minimal permissions needed: Workbench (read), Threat Intelligence (read).
VISION_ONE_API_KEY=changeme

# Vision One region. One of: us, eu, au, jp, sg, in, mea
VISION_ONE_REGION=us

# Optional: override the full base URL instead of deriving it from the region
# (useful for internal/gov environments). Leave unset to use the region default.
# VISION_ONE_BASE_URL=https://api.xdr.trendmicro.com

# Whether this server enforces the bearer-token check below. Leave this true for
# Claude Desktop (its custom connector can present a static token). Set to false only
# for clients that can't -- e.g. ChatGPT Developer Mode, which only supports OAuth or
# no-auth -- and only on a network you trust, since it makes every tool call anonymous.
MCP_REQUIRE_AUTH=true

# Shared secret a client (e.g. Claude Desktop) must send as: Authorization: Bearer <this value>.
# Ignored when MCP_REQUIRE_AUTH=false.
MCP_BEARER_TOKEN=changeme

# Host/port the MCP server binds to inside the container
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Only used by the `caddy` service in docker-compose.yml (see deploy/ec2/README.md).
# CADDY_DOMAIN must have DNS already pointed at this host.
CADDY_DOMAIN=vision-one-mcp.example.com
CADDY_EMAIL=changeme@example.com
